<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.fastllm</groupId>
  <artifactId>fast-extensions</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>fast-extensions</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <scala.binary.version>3</scala.binary.version>
    <scala.version>3.7.0</scala.version>
    <!-- Central jars 0.3.2; natives zip stays 0.3.0 (not published with the rest). -->
    <agent-engine-api.version>0.3.4</agent-engine-api.version>
    <agent-runtime.version>0.3.4</agent-runtime.version>
    <agent.version>0.3.4</agent.version>
    <agent-natives.version>0.3.0</agent-natives.version>
    <!-- Transitional: Apple Silicon needs osx-arm64 JNI. agent-natives 0.3.0 still
         ships rocksdbjni 6.6.4 (Intel-only). Take official 9.x from Central until a
         new natives zip can be published. -->
    <rocksdbjni.version>9.11.2</rocksdbjni.version>
  </properties>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <modules>
    <module>example-engine</module>
    <module>dsh-engine</module>
    <module>dist</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ai.fastllm</groupId>
        <artifactId>agent-engine-api_3</artifactId>
        <version>${agent-engine-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.rocksdb</groupId>
        <artifactId>rocksdbjni</artifactId>
        <version>${rocksdbjni.version}</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-common</artifactId>
        <version>4.2.15.Final</version>
      </dependency>
      <dependency>
        <groupId>io.circe</groupId>
        <artifactId>circe-core_3</artifactId>
        <version>0.14.13</version>
      </dependency>
      <dependency>
        <groupId>io.circe</groupId>
        <artifactId>circe-numbers_3</artifactId>
        <version>0.14.13</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>net.alchim31.maven</groupId>
          <artifactId>scala-maven-plugin</artifactId>
          <version>4.8.1</version>
          <executions>
            <execution>
              <goals>
                <goal>compile</goal>
                <goal>testCompile</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <scalaVersion>${scala.version}</scalaVersion>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
