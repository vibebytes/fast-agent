<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.fastllm</groupId>
    <artifactId>fast-extensions</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>fast-extensions-dist</artifactId>
  <packaging>pom</packaging>
  <name>fast-extensions-dist</name>
  <properties>
    <engine.os>darwin-arm64</engine.os>
  </properties>
  <dependencies>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>agent-cli_3</artifactId>
      <version>${agent.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>agent-natives</artifactId>
      <version>${agent-natives.version}</version>
      <type>zip</type>
      <classifier>${engine.os}</classifier>
    </dependency>
    <!-- Transitional: official 9.x JNI (has osx-arm64). Do not take rocksdbjni from agent-natives 0.3.0. -->
    <dependency>
      <groupId>org.rocksdb</groupId>
      <artifactId>rocksdbjni</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>fast-engine-example</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>fast-engine-dsh</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>agent-ext-memory_3</artifactId>
      <version>${agent.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>agent-ext-code-index_3</artifactId>
      <version>${agent.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.fastllm</groupId>
      <artifactId>agent-ext-mcp_3</artifactId>
      <version>${agent.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>natives-darwin-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <engine.os>darwin-arm64</engine.os>
      </properties>
    </profile>
    <profile>
      <id>natives-darwin-x64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <engine.os>darwin-x64</engine.os>
      </properties>
    </profile>
    <profile>
      <id>natives-linux-x64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <engine.os>linux-x64</engine.os>
      </properties>
    </profile>
    <profile>
      <id>natives-linux-arm64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <engine.os>linux-arm64</engine.os>
      </properties>
    </profile>
    <profile>
      <id>natives-win32-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <engine.os>win32-x64</engine.os>
      </properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-host-lib</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/agent/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <excludeArtifactIds>fast-engine-dsh,fast-engine-example,agent-ext-memory_3,agent-ext-code-index_3,agent-ext-mcp_3,agent-natives,scala3-compiler_3,scala-compiler,scalafmt-core_2.13,json-unit-core,lance-core,arrow-dataset</excludeArtifactIds>
              <excludeTypes>zip,test-jar</excludeTypes>
              <excludeClassifiers>sources,javadoc</excludeClassifiers>
              <excludeGroupIds>junit,org.junit,org.scalatest,org.assertj</excludeGroupIds>
            </configuration>
          </execution>
          <execution>
            <id>copy-extensions</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>fast-engine-example</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/dist/extensions/example</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>fast-engine-dsh</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/dist/extensions/dsh</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>agent-ext-memory_3</artifactId>
                  <version>${agent.version}</version>
                  <outputDirectory>${project.build.directory}/dist/extensions/memory</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>agent-ext-code-index_3</artifactId>
                  <version>${agent.version}</version>
                  <outputDirectory>${project.build.directory}/dist/extensions/code-index</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>agent-ext-mcp_3</artifactId>
                  <version>${agent.version}</version>
                  <outputDirectory>${project.build.directory}/dist/extensions/mcp</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>unpack-natives</id>
            <phase>package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>agent-natives</artifactId>
                  <version>${agent-natives.version}</version>
                  <type>zip</type>
                  <classifier>${engine.os}</classifier>
                  <outputDirectory>${project.build.directory}/dist/agent</outputDirectory>
                  <!-- Transitional: keep rg/treesitter from 0.3.0; drop Intel-only rocksdbjni 6.6.4. -->
                  <excludes>lib/*rocksdbjni*,lib/org.rocksdb.rocksdbjni*</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>unpack-agents-yaml</id>
            <phase>package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.fastllm</groupId>
                  <artifactId>agent-coding_3</artifactId>
                  <version>${agent.version}</version>
                  <includes>agents/**</includes>
                  <outputDirectory>${project.build.directory}/dist/agent/conf</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-conf</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
